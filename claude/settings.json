{
  "permissions": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 365,
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Google Drive"
    }
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Git/dotfiles/claude/hooks/auto-commit-dotfiles.sh"
          },
          {
            "type": "command",
            "command": "$HOME/Git/dotfiles/claude/hooks/chktex.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/Git/dotfiles/claude/hooks/stray-processes.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/Git/dotfiles/claude/hooks/bash-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/Git/dotfiles/claude/hooks/protect-checks.py"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "switchModelsOnFlag": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  }
}
